{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Auth0": {
    "Domain": "",
    "Audience": ""
  },
  "Payments": {
    "Stripe": {
      "SecretKey": "",
      "WebhookSecret": "",
      "SuccessUrlBase": "http://localhost:5173/orders",
      "CancelUrlBase": "http://localhost:5173/events"
    }
  },
  "UserProfile": {
    "DefaultAvatarUrl": "/images/default-avatar.png"
  },
  "GroupProfile": {
    "DefaultImageUrl": "/images/default-group.png"
  },
  "Events": {
    "MaxPublishesPerHostPerWeek": 6
  },
  "Media": {
    "RootPath": "uploads",
    "Profiles": {
      "EventBanner": {
        "MaxMegabytes": 5,
        "MaxWidth": 1920,
        "MaxHeight": 1080,
        "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp" ]
      },
      "GroupProfile": {
        "MaxMegabytes": 2,
        "MaxWidth": 800,
        "MaxHeight": 800,
        "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp" ]
      },
      "UserAvatar": {
        "MaxMegabytes": 2,
        "MaxWidth": 512,
        "MaxHeight": 512,
        "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp" ]
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
